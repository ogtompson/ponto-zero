# Copie para ".env" só se quiser mudar algo. Sem .env o compose usa estes mesmos valores.

# Usuário do Docker Hub onde as imagens estão publicadas
DOCKERHUB_USER=ogabrieltenorio
TAG=1.0

# Portas no seu computador
WEB_PORTA=8080
DB_PORTA=55432

# Banco (superusuário do Postgres, usado só pelo container do banco)
POSTGRES_DB=pontozero
POSTGRES_USER=pontozero
POSTGRES_PASSWORD=pontozero_admin

# Usuário com permissões mínimas que a API usa
APP_DB_USER=pontozero_app
APP_DB_PASSWORD=pontozero_app

# Segredo que assina a sessão (troque em produção)
JWT_SECRET=troque-este-segredo
